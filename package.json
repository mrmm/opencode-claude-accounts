{
  "name": "opencode-claude-accounts",
  "version": "2.1.4",
  "description": "OpenCode plugin that uses your Claude Code credentials and balances requests across several Claude accounts.",
  "keywords": [
    "anthropic",
    "auth",
    "claude",
    "opencode",
    "plugin"
  ],
  "homepage": "https://github.com/mrmm/opencode-claude-accounts#readme",
  "bugs": {
    "url": "https://github.com/mrmm/opencode-claude-accounts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrmm/opencode-claude-accounts.git"
  },
  "files": [
    "opencode-claude-auth.js",
    "dist",
    "installation.md",
    "index.js",
    "tui.tsx",
    "tui/claude-auth-tui.tsx",
    "tui/v2-adapter.tsx",
    "llms.txt"
  ],
  "type": "module",
  "main": "opencode-claude-auth.js",
  "module": "opencode-claude-auth.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./opencode-claude-auth.js",
      "default": "./opencode-claude-auth.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./opencode-claude-auth.js",
      "default": "./opencode-claude-auth.js"
    },
    "./claude-auth-plugin": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./claude-auth-plugin.js": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./opencode-claude-auth": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./opencode-claude-auth.js": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": "./tui/claude-auth-tui.tsx"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf .dist-next && tsc --outDir .dist-next && cp src/anthropic-prompt.txt .dist-next/ && node scripts/swap-dist.mjs && node scripts/stamp.mjs",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts' 'scripts/**/*.test.ts'",
    "test:models": "pnpm run build && node scripts/test-models.ts",
    "test:headless": "pnpm run build && node --experimental-strip-types scripts/test-headless.ts",
    "intercept": "pnpm run build && node --experimental-strip-types scripts/intercept-claude.ts",
    "intercept:all": "pnpm run build && node --experimental-strip-types scripts/intercept-claude.ts --all",
    "intercept:update": "pnpm run build && node --experimental-strip-types scripts/intercept-claude.ts --all --update",
    "validate:oauth": "pnpm run build && node --experimental-strip-types scripts/validate-oauth-refresh.ts",
    "lint": "oxlint && oxfmt --check . && pnpm run check:structure && pnpm run check:tui",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "format": "oxfmt --write .",
    "prepublishOnly": "pnpm run build && pnpm test",
    "test:rotation": "pnpm run build && node --experimental-strip-types scripts/test-rotation-headless.ts",
    "usage": "pnpm run build && node --experimental-strip-types scripts/usage-report.ts",
    "lb": "pnpm run build && node --experimental-strip-types scripts/lb.ts",
    "check:structure": "node --experimental-strip-types scripts/check-structure.ts",
    "capture": "node --experimental-strip-types scripts/capture.ts",
    "dash": "pnpm run build && node --experimental-strip-types scripts/dash.ts",
    "prompt": "pnpm run build && node --experimental-strip-types scripts/prompt-analyze.ts",
    "check:v2": "bun tui/v2-adapter.runtime-check.ts",
    "check:tui": "tsc -p tui/tsconfig.json"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.27"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.31",
    "@opentui/core": "^0.5.11",
    "@opentui/keymap": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "@types/node": "^25.5.0",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "solid-js": "^1.9.15",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "packageManager": "pnpm@10.32.1"
}
